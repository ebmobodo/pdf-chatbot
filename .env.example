# ---- Required secrets (never commit the real .env) ----

# Google Gemini
GOOGLE_API_KEY=""

# Supabase project URL + service-role key
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# NVIDIA NIM API key (embeddings)
NVIDIA_API_KEY=""

# ---- Optional overrides (defaults shown) ----

# LLM_MODEL="gemini-2.5-flash"
# LLM_TEMPERATURE="0.3"

# Groq fallback LLM (used when Gemini fails). Optional, but recommended.
# GROQ_API_KEY=""
# FALLBACK_LLM_MODEL="llama-3.3-70b-versatile"
# EMBED_MODEL="nvidia/nv-embedqa-e5-v5"
# EMBED_BASE_URL="https://integrate.api.nvidia.com/v1"

# CHUNK_SIZE="1000"
# CHUNK_OVERLAP="200"

# OCR for scanned PDF pages (pypdf extracts text; OCR fills in blank pages).
# OCR_ENABLED="false"        # requires poppler-utils + tesseract-ocr installed
# OCR_DPI="300"
# OCR_LANGUAGE="eng"

# POSTGREST_TIMEOUT="60"
